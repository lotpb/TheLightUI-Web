# Copy this file to .env.local and fill in your values.
# Register a Web App in Firebase Console → Project Settings → Your apps → Add app (Web)
# to get VITE_FIREBASE_APP_ID and VITE_FIREBASE_MEASUREMENT_ID.

VITE_FIREBASE_API_KEY=AIzaSyAfreL3f4UiXpvItb7U-tQhThSJn5OYoMY
VITE_FIREBASE_AUTH_DOMAIN=thelightui.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=thelightui
VITE_FIREBASE_STORAGE_BUCKET=thelightui.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=753463338762
VITE_FIREBASE_APP_ID=1:753463338762:web:REPLACE_WITH_YOUR_WEB_APP_ID

# Web push notifications — Firebase Console → Project Settings → Cloud Messaging
# → Web configuration → Web Push certificates → Generate key pair.
VITE_FIREBASE_VAPID_KEY=REPLACE_WITH_YOUR_VAPID_KEY

# Google Maps — enable Maps JavaScript API, Directions API, and Geocoding API
# in Google Cloud Console → APIs & Services for the same GCP project.
VITE_GOOGLE_MAPS_API_KEY=REPLACE_WITH_YOUR_GOOGLE_MAPS_API_KEY

# reCAPTCHA v3 — protects /register against automated account creation.
# 1. Go to https://www.google.com/recaptcha/admin/create
# 2. Choose reCAPTCHA v3, add your domain (thelightui.web.app + localhost)
# 3. Copy the Site Key here and the Secret Key to Firebase Functions:
#    firebase functions:secrets:set RECAPTCHA_SECRET_KEY
# Leave blank to disable reCAPTCHA (open registration, no bot protection).
VITE_RECAPTCHA_SITE_KEY=
