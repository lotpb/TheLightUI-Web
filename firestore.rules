rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // True when the caller's ID-token carries a non-empty companyId custom claim.
    function hasCompanyId() {
      return isSignedIn()
          && 'companyId' in request.auth.token
          && request.auth.token.companyId is string
          && request.auth.token.companyId.size() > 0;
    }

    // Caller's companyId claim. Only invoke after hasCompanyId() is true.
    function claimedCompanyId() {
      return request.auth.token.companyId;
    }

    // True when the authenticated uid matches the given uid parameter.
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Caller's role, read from their own users/{uid} doc. '' if signed out or
    // the doc/field is missing. One get() per rule evaluation — well within
    // the per-request budget since each write only evaluates its own rule once.
    function callerRole() {
      return isSignedIn()
           ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '')
           : '';
    }

    // Viewer is the read-only role (see usePermissions.ts canEdit: false) —
    // enforced here so it's a real security boundary, not just a hidden button.
    function isViewer() {
      return callerRole() == 'viewer';
    }

    // Team management (invite/role-change) is owner/admin only.
    function canManageTeam() {
      return callerRole() == 'owner' || callerRole() == 'admin';
    }

    // ── User Profiles ─────────────────────────────────────────────────────────
    //
    //   Own profile: full read/write (profile edits, FCM token arrayUnion).
    //   list/get of other users is scoped to same-company membership only —
    //   the "New Message" picker (ChatRepository.fetchAvailableUsers) already
    //   queries whereField("companyId", isEqualTo: callerCompanyId), so this
    //   constraint doesn't change that flow's behavior, it just stops an
    //   unfiltered or cross-company query from succeeding server-side.
    //   All deletes: denied.
    //
    match /users/{userId} {
      allow get:    if isOwner(userId)
                    || (hasCompanyId()
                        && resource.data.get('companyId', '') == claimedCompanyId());
      allow list:   if hasCompanyId()
                    && resource.data.companyId == claimedCompanyId();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
                    // Owner/admin may change only the role or companyId of a
                    // team member who shares the same companyId.
                    || (isSignedIn()
                        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['owner', 'admin']
                        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '') == resource.data.get('companyId', '')
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'companyId']));
      allow delete: if false;
    }

    // ── Customers ─────────────────────────────────────────────────────────────
    //
    //   All CRUD is scoped to the caller's companyId ID-token claim.
    //   `list` permits company-filtered queries; `get` / write / delete each
    //   verify the document's stored companyId field matches the claim.
    //
    //   The resource.data.companyId check on `list` is intentional: Firestore
    //   uses it as a query constraint, rejecting any query that does not carry
    //   where('companyId','==',callerCompanyId). This prevents cross-company
    //   data access via unfiltered SDK queries.
    //
    //   Migration update: a document that has no companyId yet (legacy record)
    //   may be claimed by the user whose uid is stored in the document, provided
    //   they stamp their own companyId. This lets CustomerFormService.migrateCompanyId()
    //   run under the new rules without requiring a backend-only migration script.
    //
    match /Customers/{customerId} {
      allow get:    if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow list:   if hasCompanyId()
                    && resource.data.companyId == claimedCompanyId();
      allow create: if hasCompanyId() && !isViewer()
                    && request.resource.data.companyId == claimedCompanyId();
      allow update: if hasCompanyId() && !isViewer()
                    && (
                         // Normal update: document already belongs to this company.
                         (resource.data.get('companyId', '') == claimedCompanyId()
                          && request.resource.data.get('companyId', '') == claimedCompanyId())
                         ||
                         // Migration: stamp companyId on an unclaimed document
                         // that was written by this user before multi-tenancy existed.
                         (resource.data.get('companyId', '') == ''
                          && resource.data.get('uid', '') == request.auth.uid
                          && request.resource.data.get('companyId', '') == claimedCompanyId())
                       );
      allow delete: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── Chat Messages ─────────────────────────────────────────────────────────
    //
    //   Structure:  messages/{ownerId}/{contactId}/{messageId}
    //
    //   Each message is mirrored: the sender batch-writes two documents —
    //   one under messages/{fromId}/{toId}/ (sender's copy)
    //   and one under messages/{toId}/{fromId}/ (recipient's copy).
    //
    //   Read:   only the owner of that path reads their copy.
    //   Create: only the sender (fromId == auth uid) may create; the rule
    //           validates both the sender's own copy and the recipient's copy.
    //   Update/Delete: messages are immutable once sent.
    //
    match /messages/{ownerId}/{contactId}/{messageId} {
      allow get, list: if isOwner(ownerId);
      allow create:    if isSignedIn()
                       && request.resource.data.fromId == request.auth.uid
                       && (
                            // Sender's own copy: ownerId == fromId.
                            request.auth.uid == ownerId
                            ||
                            // Recipient's copy: ownerId == toId.
                            request.resource.data.toId == ownerId
                          );
      allow update, delete: if false;
    }

    // ── Recent Messages Index ─────────────────────────────────────────────────
    //
    //   Structure:  recent_messages/{userId}/messages/{contactId}
    //
    //   Each user maintains their own inbox entry. The sender batch-writes
    //   both the sender's and the recipient's recent-message documents.
    //
    //   Read:   inbox owner only.
    //   Write:  inbox owner, OR the sender stamping the recipient's entry
    //           (fromId in the written data must equal the authenticated uid).
    //
    match /recent_messages/{userId}/messages/{contactId} {
      allow get, list: if isOwner(userId);
      allow write:     if isOwner(userId)
                       || (isSignedIn()
                           && request.resource.data.fromId == request.auth.uid);
    }

    // ── Expenses ──────────────────────────────────────────────────────────────
    //
    //   All CRUD scoped to the caller's companyId claim.
    //
    match /Expenses/{expenseId} {
      allow get:    if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow list:   if hasCompanyId()
                    && resource.data.companyId == claimedCompanyId();
      allow create: if hasCompanyId() && !isViewer()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow update: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow delete: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── To-Do Items ───────────────────────────────────────────────────────────
    //
    //   All CRUD scoped to the caller's companyId claim.
    //
    match /ToDoItems/{itemId} {
      allow get:    if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow list:   if hasCompanyId()
                    && resource.data.companyId == claimedCompanyId();
      allow create: if hasCompanyId() && !isViewer()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow update: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow delete: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── Referrals ─────────────────────────────────────────────────────────────
    //
    //   One document per referral pair. All CRUD scoped to the caller's companyId.
    //
    match /referrals/{referralId} {
      allow get:    if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow list:   if hasCompanyId()
                    && resource.data.companyId == claimedCompanyId();
      allow create: if hasCompanyId() && !isViewer()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow delete: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── Time Entries ──────────────────────────────────────────────────────────
    //
    //   Clock-in/out records per job. All CRUD scoped to the caller's companyId.
    //
    match /timeEntries/{entryId} {
      allow get:    if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow list:   if hasCompanyId()
                    && resource.data.companyId == claimedCompanyId();
      allow create: if hasCompanyId() && !isViewer()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow update: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow delete: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── Public Invoice Snapshots ──────────────────────────────────────────────
    //
    //   Document ID is the share token (UUID). Anyone can read a single doc
    //   (no auth needed — customer link). Only the owning company can write.
    //
    match /publicInvoices/{token} {
      allow get:    if true;
      allow create: if hasCompanyId()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow update: if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow delete: if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── Customer Portals ──────────────────────────────────────────────────────
    //   Public read (token acts as auth). Company members can write.
    //
    match /customerPortals/{token} {
      allow get:    if true;
      allow create: if hasCompanyId()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow update: if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow delete: if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── Service Requests (public submissions from customer portal) ────────────
    //   Anyone can create; only company members can read/delete.
    //
    match /serviceRequests/{requestId} {
      allow create: if true;
      allow read: if hasCompanyId()
                  && resource.data.get('companyId', '') == claimedCompanyId();
      allow delete: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow update: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── Product Catalog ───────────────────────────────────────────────────────
    //
    //   All CRUD scoped to the caller's companyId claim.
    //
    // ── Invites ───────────────────────────────────────────────────────────────
    //   get is public (no auth) because JoinPage shows the invite's role/company
    //   to a brand-new recruit before they've signed in or registered — the
    //   random `code` doc ID is itself the bearer secret. Only company members
    //   can create. Update allowed once (to mark used). No delete.
    match /invites/{code} {
      allow get:    if true;
      allow list:   if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      // Direct client creation previously allowed ANY company member (including
      // viewer/salesman) to write an invite doc, bypassing inviteUser's
      // owner/admin check entirely. Team management is owner/admin only.
      allow create: if hasCompanyId() && canManageTeam();
      // Consuming an invite (inviteService.acceptInvite) is the only client
      // update, so it may touch only the consumption fields. Without the
      // hasOnly() constraint any signed-in user could rewrite an unused
      // invite's role or companyId and grant themselves owner in a company
      // they don't belong to.
      allow update: if isSignedIn()
                    && resource.data.used == false
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.companyId == resource.data.companyId
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['used', 'usedBy', 'usedByEmail', 'usedByName', 'usedAt']);
      allow delete: if false;
    }

    match /catalog/{itemId} {
      allow get:    if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow list:   if hasCompanyId()
                    && resource.data.companyId == claimedCompanyId();
      allow create: if hasCompanyId() && !isViewer()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow update: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow delete: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── Commission Structure ──────────────────────────────────────────────────
    //
    //   One document per company. Any authenticated team member can read (to
    //   calculate their own commission); only users with a companyId claim can
    //   write (protects other companies' structures).
    //
    match /commissionStructures/{companyId} {
      allow read:  if hasCompanyId() && request.auth.token.companyId == companyId;
      allow write: if hasCompanyId() && !isViewer() && request.auth.token.companyId == companyId;
    }

    // ── Service Plans ─────────────────────────────────────────────────────────
    //
    //   All CRUD scoped to the caller's companyId claim.
    //
    match /ServicePlans/{planId} {
      allow get:    if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow list:   if hasCompanyId()
                    && resource.data.companyId == claimedCompanyId();
      allow create: if hasCompanyId() && !isViewer()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow update: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow delete: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── Warranties ─────────────────────────────────────────────────────────────
    //
    //   Coverage-period tracking per customer, with expiration reminders sent
    //   by the warrantyExpirationReminders scheduled Cloud Function.
    //
    match /Warranties/{warrantyId} {
      allow get:    if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow list:   if hasCompanyId()
                    && resource.data.companyId == claimedCompanyId();
      allow create: if hasCompanyId() && !isViewer()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow update: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow delete: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── Claim Refresh Signals ─────────────────────────────────────────────────
    //
    //   Written only by Cloud Functions (Admin SDK bypasses these rules).
    //   Clients watch their own document to detect when custom claims have
    //   changed server-side (e.g., after being invited to a company) and
    //   force-refresh their ID token without requiring a manual re-login.
    //
    match /claimRefreshSignals/{uid} {
      allow read:  if isOwner(uid);
      allow write: if false;
    }

    // ── Activities ────────────────────────────────────────────────────────────
    //
    //   Timeline entries tied to a customer. Always company-scoped.
    //
    match /Activities/{activityId} {
      allow get:    if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow list:   if hasCompanyId()
                    && resource.data.companyId == claimedCompanyId();
      allow create: if hasCompanyId() && !isViewer()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow update: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow delete: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── Invoices ──────────────────────────────────────────────────────────────
    //
    //   All CRUD scoped to the caller's companyId claim.
    //
    match /Invoices/{invoiceId} {
      allow get:    if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow list:   if hasCompanyId()
                    && resource.data.companyId == claimedCompanyId();
      allow create: if hasCompanyId() && !isViewer()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow update: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow delete: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── Dispatch Board ────────────────────────────────────────────────────────
    //
    //   Scheduled visits (techs assigned to a job/service request/service plan
    //   on a given day). Written directly by staff from the client, unlike the
    //   internal provider-credential collections above — full CRUD scoped to
    //   the caller's companyId claim, same pattern as Invoices.
    //
    match /dispatchAssignments/{assignmentId} {
      allow get:    if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow list:   if hasCompanyId()
                    && resource.data.companyId == claimedCompanyId();
      allow create: if hasCompanyId() && !isViewer()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow update: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow delete: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── Proposals ─────────────────────────────────────────────────────────────
    //
    //   Quotes/estimates sent to a customer, optionally converted to an
    //   Invoice once accepted. All CRUD scoped to the caller's companyId claim.
    //
    match /Proposals/{proposalId} {
      allow get:    if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow list:   if hasCompanyId()
                    && resource.data.companyId == claimedCompanyId();
      allow create: if hasCompanyId() && !isViewer()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow update: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow delete: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── Public Proposal Snapshots ──────────────────────────────────────────────
    //
    //   Document ID is the share token (UUID). Anyone can read a single doc
    //   (no auth needed — customer link). Company members create/refresh the
    //   snapshot. The customer (unauthenticated) may also flip status from
    //   'sent' to 'accepted'/'declined' — onProposalResponse (Cloud Function)
    //   mirrors that back onto the real Proposals doc.
    //
    match /publicProposals/{token} {
      allow get: if true;
      allow create: if hasCompanyId() && !isViewer()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow update: if (hasCompanyId() && !isViewer()
                        && resource.data.get('companyId', '') == claimedCompanyId())
                    || (resource.data.get('status', '') == 'sent'
                        && request.resource.data.get('status', '') in ['accepted', 'declined']
                        && request.resource.data.get('companyId', '') == resource.data.get('companyId', '')
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']));
      allow delete: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── Goals ─────────────────────────────────────────────────────────────────
    //
    //   Document ID is the companyId itself (Goals/{companyId}), so the
    //   path variable is the authoritative ownership check.
    //
    match /Goals/{goalCompanyId} {
      allow read:  if hasCompanyId() && claimedCompanyId() == goalCompanyId;
      allow write: if hasCompanyId() && !isViewer() && claimedCompanyId() == goalCompanyId;
    }

    // ── Customer Documents ────────────────────────────────────────────────────
    //
    //   Firestore metadata records for uploaded files. All CRUD company-scoped.
    //   Storage access is controlled separately in storage.rules.
    //
    match /Documents/{documentId} {
      allow get:    if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow list:   if hasCompanyId()
                    && resource.data.companyId == claimedCompanyId();
      allow create: if hasCompanyId() && !isViewer()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow delete: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── Signing Requests ──────────────────────────────────────────────────────
    //
    //   Token-based e-signature documents. Doc ID is a UUID (the signing link token).
    //   Public get so the signing page loads without auth.
    //   Company members create. Signer (unauthed) can update status pending→signed.
    //   Company members delete.
    //
    match /signingRequests/{token} {
      allow get:    if true;
      allow list:   if hasCompanyId()
                    && resource.data.companyId == claimedCompanyId();
      allow create: if hasCompanyId() && !isViewer()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      // Signer submits (unauthenticated, public link): only pending→signed
      // transition, companyId unchanged. Not viewer-gated — the signer isn't
      // a team member at all.
      allow update: if resource.data.get('status', '') == 'pending'
                    && request.resource.data.get('status', '') == 'signed'
                    && request.resource.data.get('companyId', '') == resource.data.get('companyId', '');
      allow delete: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── Lead Capture Forms ────────────────────────────────────────────────────
    //
    //   Settings stored per company (doc ID = companyId).
    //   Public get so the public form page can load settings without auth.
    //   Writes restricted to the owning company.
    //
    match /leadForms/{formCompanyId} {
      allow get:   if true;
      allow write: if hasCompanyId() && !isViewer() && claimedCompanyId() == formCompanyId;
    }

    // ── Lead Submissions ──────────────────────────────────────────────────────
    //
    //   Anyone can submit (public contact form). Only the owning company can
    //   read, update status, or delete submissions.
    //
    match /leadSubmissions/{subId} {
      allow create: if true;
      allow read: if hasCompanyId()
                  && resource.data.get('companyId', '') == claimedCompanyId();
      // update and delete are split so the update branch can also pin the
      // incoming companyId — a combined rule cannot, because a delete has no
      // request.resource to check.
      allow update: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow delete: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── Document Templates ────────────────────────────────────────────────────
    //
    //   Reusable proposal/contract/report/letter templates. Company-scoped.
    //
    match /docTemplates/{templateId} {
      allow get:    if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow list:   if hasCompanyId()
                    && resource.data.companyId == claimedCompanyId();
      allow create: if hasCompanyId() && !isViewer()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow update: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow delete: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── Email Campaigns ───────────────────────────────────────────────────────
    //
    //   Campaign definitions. All CRUD scoped to the caller's companyId claim.
    //
    match /campaigns/{campaignId} {
      allow get:    if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow list:   if hasCompanyId()
                    && resource.data.companyId == claimedCompanyId();
      allow create: if hasCompanyId() && !isViewer()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow update: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow delete: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── Campaign Recipients ───────────────────────────────────────────────────
    //
    //   One doc per contact per campaign. All CRUD scoped to the caller's companyId.
    //
    match /campaignRecipients/{recipientId} {
      allow get:    if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow list:   if hasCompanyId()
                    && resource.data.companyId == claimedCompanyId();
      allow create: if hasCompanyId() && !isViewer()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow update: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow delete: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── API Keys ───────────────────────────────────────────────────────────────
    //
    //   Inbound read-only API access. Only keyHash (SHA-256, one-way) is ever
    //   stored — the raw key is generated client-side and shown once. All CRUD
    //   scoped to the caller's companyId claim; the read API (apiRead Cloud
    //   Function) looks keys up by hash via the admin SDK, bypassing these rules.
    //
    match /apiKeys/{keyId} {
      allow get:    if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow list:   if hasCompanyId()
                    && resource.data.companyId == claimedCompanyId();
      allow create: if hasCompanyId() && !isViewer()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow update: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow delete: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── Notifications (persistent bell icon) ──────────────────────────────────
    //
    //   Written only by Cloud Functions (admin SDK). Company members can read
    //   and mark their own company's notifications read.
    //
    match /notifications/{notifId} {
      allow get:    if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow list:   if hasCompanyId()
                    && resource.data.companyId == claimedCompanyId();
      allow create: if false;
      // update is a shared "mark read" flag toggled by every team member
      // (including viewer) with no client-side gating — not a CRM data edit,
      // so it's intentionally not viewer-restricted.
      allow update: if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow delete: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── Webhook Subscriptions ──────────────────────────────────────────────────
    //
    //   Outbound integrations (Zapier, custom tools). All CRUD scoped to the
    //   caller's companyId claim. Delivery + status updates happen via Cloud
    //   Functions (admin SDK, bypasses these rules).
    //
    match /webhookSubscriptions/{subId} {
      allow get:    if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow list:   if hasCompanyId()
                    && resource.data.companyId == claimedCompanyId();
      allow create: if hasCompanyId() && !isViewer()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow update: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow delete: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── Purchase Orders ────────────────────────────────────────────────────────
    //
    //   Vendor/job PO tracking. All CRUD scoped to the caller's companyId claim.
    //
    match /purchaseOrders/{poId} {
      allow get:    if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow list:   if hasCompanyId()
                    && resource.data.companyId == claimedCompanyId();
      allow create: if hasCompanyId() && !isViewer()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow update: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow delete: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── Audit Log ──────────────────────────────────────────────────────────────
    //
    //   Read-only change history for Customers/Invoices, written only by Cloud
    //   Functions (onCustomerAudit, onInvoiceAudit) via the admin SDK.
    //
    match /auditLog/{entryId} {
      allow get:    if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow list:   if hasCompanyId()
                    && resource.data.companyId == claimedCompanyId();
      allow create, update, delete: if false;
    }

    // ── Saved Views ────────────────────────────────────────────────────────────
    //
    //   Named filter/sort presets for Leads/Customers/Vendors/Employees lists.
    //   Shared company-wide, like picker lists. All CRUD scoped to companyId.
    //
    match /savedViews/{viewId} {
      allow get:    if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow list:   if hasCompanyId()
                    && resource.data.companyId == claimedCompanyId();
      allow create: if hasCompanyId() && !isViewer()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow update: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow delete: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── Email Messages (two-way email sync) ───────────────────────────────────
    //
    //   Sent + received emails, threaded per customer. Written only by Cloud
    //   Functions (bulkSendEmail, automation actions, emailInboundWebhook) via
    //   the admin SDK, which bypasses these rules — so create is locked down.
    //
    match /emailMessages/{messageId} {
      allow get:    if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow list:   if hasCompanyId()
                    && resource.data.companyId == claimedCompanyId();
      allow create: if false;
      // update is a shared "mark read" flag, same reasoning as notifications above.
      allow update: if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow delete: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── SMS number → company lookup (internal) ────────────────────────────────
    //
    //   Maps a Twilio "from" number to the owning companyId so
    //   smsInboundWebhook can resolve tenancy without a collection-group
    //   query. Read/written only by Cloud Functions via the admin SDK.
    //
    match /smsNumberIndex/{number} {
      allow read, write: if false;
    }

    // ── SMS opt-out registry (internal) ───────────────────────────────────────
    //
    //   Keyed by company + phone (not customerId) so a number that texts
    //   STOP stays blocked even if it's later linked to a different or
    //   newly-created customer record. Read/written only by Cloud Functions
    //   via the admin SDK.
    //
    match /smsOptOuts/{docId} {
      allow read, write: if false;
    }

    // ── QuickBooks OAuth (internal) ────────────────────────────────────────────
    //
    //   quickbooksTokens holds live access/refresh tokens per company;
    //   oauthStates is a short-lived correlation doc for the OAuth redirect
    //   round-trip. Both are read/written only by Cloud Functions via the
    //   admin SDK — never exposed to the client.
    //
    match /quickbooksTokens/{companyId} {
      allow read, write: if false;
    }
    match /oauthStates/{state} {
      allow read, write: if false;
    }

    // ── Stripe Connect (internal) ─────────────────────────────────────────────
    //
    //   Maps a company to its own connected Stripe account so
    //   createStripeCheckout can create sessions that pay out directly to
    //   that company's bank account instead of the platform's. The account id
    //   itself isn't secret (same class of identifier as QuickBooks' realmId),
    //   but this doc is still Functions-only for consistency with the other
    //   provider-credential collections. The client-visible mirror lives at
    //   companies/{companyId}/settings/stripeConnectStatus.
    //
    match /stripeConnectAccounts/{companyId} {
      allow read, write: if false;
    }

    // ── Facebook Lead Ads (internal) ──────────────────────────────────────────
    //
    //   facebookTokens holds the long-lived user token plus one access token
    //   per connected Page — never exposed to the client, which instead reads
    //   the sanitised mirror at companies/{companyId}/settings/facebookStatus
    //   (Page names and ids only, no tokens).
    //
    //   facebookPageIndex maps a Facebook pageId to the owning companyId so
    //   facebookLeadWebhook can resolve tenancy in a single doc read (same
    //   reasoning as smsNumberIndex above); it also carries that Page's rate
    //   limit counters. facebookLeadgenIds is the idempotency ledger that stops
    //   Meta's webhook retries from creating duplicate leads.
    //
    match /facebookTokens/{companyId} {
      allow read, write: if false;
    }
    match /facebookPageIndex/{pageId} {
      allow read, write: if false;
    }
    match /facebookLeadgenIds/{leadgenId} {
      allow read, write: if false;
    }

    // Per-lead ingestion failures, surfaced read-only in the CRM so an admin
    // can see which leads didn't make it. Written only by Cloud Functions.
    match /facebookLeadErrors/{errorId} {
      allow get:   if hasCompanyId()
                   && resource.data.get('companyId', '') == claimedCompanyId();
      allow list:  if hasCompanyId()
                   && resource.data.companyId == claimedCompanyId();
      allow write: if false;
    }

    // ── AI usage counters (internal) ──────────────────────────────────────────
    //
    //   Per-company daily draftReply quota tracking (see AI_DRAFTS_PER_DAY in
    //   functions/src/index.ts). Read/written only by Cloud Functions via the
    //   admin SDK — a client-writable counter would defeat the point of it.
    //
    match /aiUsage/{companyId} {
      allow read, write: if false;
    }

    // ── Financing (internal + staff-readable) ─────────────────────────────────
    //
    //   financingCredentials holds the per-company provider API key — a loan
    //   payout goes to that specific company's own bank account, so unlike the
    //   platform-wide Stripe key this cannot be shared across companies. Never
    //   exposed to the client, which instead reads the sanitised mirror at
    //   companies/{companyId}/settings/financingStatus.
    //
    //   financingApplications is staff-readable (the detail page shows status)
    //   but write-only-via-Cloud-Function — createFinancingApplication and
    //   financingWebhook both use the admin SDK. generateShareToken (client
    //   SDK) also needs a `get` here to carry the apply link/status forward
    //   onto a regenerated public snapshot.
    //
    match /financingCredentials/{companyId} {
      allow read, write: if false;
    }
    match /financingApplications/{applicationId} {
      allow get:   if hasCompanyId()
                   && resource.data.get('companyId', '') == claimedCompanyId();
      allow list:  if hasCompanyId()
                   && resource.data.companyId == claimedCompanyId();
      allow write: if false;
    }

    // ── SMS Messages (two-way text sync) ──────────────────────────────────────
    //
    //   Sent + received texts, threaded per customer. Written only by Cloud
    //   Functions (sendSms, smsInboundWebhook, smsStatusWebhook) via the admin
    //   SDK, which bypasses these rules — so create is locked down.
    //
    match /smsMessages/{messageId} {
      allow get:    if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow list:   if hasCompanyId()
                    && resource.data.companyId == claimedCompanyId();
      allow create: if false;
      // update is a shared "mark read" flag, same reasoning as notifications above.
      allow update: if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow delete: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── Custom Field Definitions ──────────────────────────────────────────────
    //
    //   Company-defined extra fields on Customer records. All CRUD scoped to
    //   the caller's companyId claim; values live inline on Customers docs.
    //
    match /customFieldDefs/{fieldId} {
      allow get:    if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow list:   if hasCompanyId()
                    && resource.data.companyId == claimedCompanyId();
      allow create: if hasCompanyId() && !isViewer()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow update: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow delete: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── Automation Rules ──────────────────────────────────────────────────────
    //
    //   If/Then triggers on Customers/Invoices. All CRUD scoped to companyId.
    //   Fired server-side by Cloud Functions using the admin SDK (bypasses rules).
    //
    match /automationRules/{ruleId} {
      allow get:    if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow list:   if hasCompanyId()
                    && resource.data.companyId == claimedCompanyId();
      allow create: if hasCompanyId() && !isViewer()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow update: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow delete: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── Automation Log ────────────────────────────────────────────────────────
    //
    //   Read-only fire history, written only by Cloud Functions (admin SDK).
    //
    match /automationLog/{logId} {
      allow get:    if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow list:   if hasCompanyId()
                    && resource.data.companyId == claimedCompanyId();
      allow create, update, delete: if false;
    }

    // ── Message Templates ─────────────────────────────────────────────────────
    //
    //   Reusable email/SMS templates. All CRUD scoped to the caller's companyId.
    //
    match /messageTemplates/{templateId} {
      allow get:    if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow list:   if hasCompanyId()
                    && resource.data.companyId == claimedCompanyId();
      allow create: if hasCompanyId() && !isViewer()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow update: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow delete: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── Follow-up Sequences ───────────────────────────────────────────────────
    //
    //   Drip campaign templates. All CRUD scoped to the caller's companyId.
    //
    match /sequences/{sequenceId} {
      allow get:    if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow list:   if hasCompanyId()
                    && resource.data.companyId == claimedCompanyId();
      allow create: if hasCompanyId() && !isViewer()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow update: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow delete: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── Sequence Enrollments ──────────────────────────────────────────────────
    //
    //   Per-customer enrollment records. All CRUD scoped to the caller's companyId.
    //   Cloud Functions use Admin SDK and bypass these rules.
    //
    match /sequenceEnrollments/{enrollmentId} {
      allow get:    if hasCompanyId()
                    && resource.data.get('companyId', '') == claimedCompanyId();
      allow list:   if hasCompanyId()
                    && resource.data.companyId == claimedCompanyId();
      allow create: if hasCompanyId() && !isViewer()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow update: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId()
                    && request.resource.data.get('companyId', '') == claimedCompanyId();
      allow delete: if hasCompanyId() && !isViewer()
                    && resource.data.get('companyId', '') == claimedCompanyId();
    }

    // ── Company Settings (Picker Lists) ───────────────────────────────────────
    //
    //   Per-company settings at companies/{companyId}/settings/{doc}.
    //   Full read/write restricted to the owning company.
    //
    match /companies/{companyId}/settings/{settingId} {
      allow read:  if hasCompanyId() && claimedCompanyId() == companyId;
      allow write: if hasCompanyId() && !isViewer() && claimedCompanyId() == companyId;
    }

    // ── Picker Lists (legacy shared document) ─────────────────────────────────
    //
    //   Retained for backward compatibility while the migration to
    //   companies/{companyId}/settings/pickerLists completes.
    //   Read: any signed-in user. Write: any user with a companyId claim.
    //
    match /settings/pickerLists {
      allow read:  if isSignedIn();
      allow write: if hasCompanyId() && !isViewer();
    }

  }
}
